  "chapters": [
    {"ch": 1, "scenes": ["scene-01"], "target_chars": 800, "hook": "再睁眼，林薇正笑着把江越推到我面前。"},
    {"ch": 2, "scenes": ["scene-02"], "target_chars": 800, "hook": "他改了城市志愿。从深圳，划到了那座我上辈子困了四十年的小城。"},
    {"ch": 3, "scenes": ["scene-03"], "target_chars": 800, "hook": "他记得林薇不吃龙虾，却不记得我碰一口就进急诊。"},
    {"ch": 4, "scenes": ["scene-04"], "target_chars": 800, "hook": "我刷新了系统页面——苏念，已签约，深圳总部。"},
    {"ch": 5, "scenes": ["scene-05"], "target_chars": 800, "hook": "顾行舟说：'你的代码风格，我一眼就能认出来。'"},
    {"ch": 6, "scenes": ["scene-06"], "target_chars": 800, "hook": "电话那头，林薇的声音带着哭腔：'他变了，跟上辈子完全不一样。'"},
    {"ch": 7, "scenes": ["scene-07"], "target_chars": 800, "hook": "林薇的手机屏亮了一下——备注名是'越哥'，后面跟着一个红心。"},
    {"ch": 8, "scenes": ["scene-08"], "target_chars": 800, "hook": "酒店走廊里，江越的声音清晰地传来：'当初如果不是你救过我，我不会答应照顾苏念一辈子。'"},
    {"ch": 9, "scenes": ["scene-09"], "target_chars": 800, "hook": "我是她施恩的赠品，是他报恩的工具。"},
    {"ch": 10, "scenes": ["scene-10"], "target_chars": 800, "hook": "那份内幕交易的截图，我存了三份。"},
    {"ch": 11, "scenes": ["scene-11"], "target_chars": 800, "hook": "证监会立案调查的公告，在江越的朋友圈炸开。"},
    {"ch": 12, "scenes": ["scene-12"], "target_chars": 800, "hook": "他单膝跪在公司楼下，手里的花被我踩进水洼。"},
    {"ch": 13, "scenes": ["scene-13"], "target_chars": 800, "hook": "警察把他从地上拉起来时，他的西装袖口沾满了泥。"},
    {"ch": 14, "scenes": ["scene-14"], "target_chars": 800, "hook": "顾行舟说：'苏念，上辈子我等了你一辈子，这次你终于看见我了。'"}
  ],
